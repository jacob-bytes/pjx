[Unit]
Description=pjx master
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pjx
Group=pjx
WorkingDirectory=/var/lib/pjx
# 推荐把口令等放 EnvironmentFile，避免写进 unit：
#   EnvironmentFile=/etc/pjx/master.env
# 里面写：PJX_ADMIN_PASSWORD=change-me
EnvironmentFile=-/etc/pjx/master.env
ExecStart=/usr/local/bin/pjx-master -listen 127.0.0.1:8080 -data-dir /var/lib/pjx
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pjx

[Install]
WantedBy=multi-user.target
