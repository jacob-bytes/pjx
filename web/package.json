{
  "name": "pjx-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:contrast": "python3 scripts/check-contrast.py",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "check:types": "tsc -b",
    "verify": "npm run check:types && npm run check:contrast && npm run test:visual",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.0.4",
    "cn": "^0.2.6",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.5",
    "sonner": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.2.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
